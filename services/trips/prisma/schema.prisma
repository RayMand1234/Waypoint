// Mirrors docs/architecture.md §5 "trips schema" exactly. Columns are plain
// text/jsonb rather than Postgres enums (status, styles, pace, …), matching
// the ERD there — the service's own Zod schemas in @waypoint/contracts are
// what actually constrain the values; Prisma just stores what they produce.
//
// Supabase's `auth` schema is not modeled here and never migrated by this
// service — Profile.userId equals auth.users.id (the JWT `sub`) by value only.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["trips"]
}

model Profile {
  userId      String   @id @map("user_id")
  name        String?
  homeAirport String?  @map("home_airport")
  createdAt   DateTime @default(now()) @map("created_at")

  trips Trip[]

  @@map("profile")
  @@schema("trips")
}

model Trip {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  status          String   @default("draft")
  styles          String[]
  pace            String   @default("balanced")
  destinationId   String?  @map("destination_id")
  destinationName String?  @map("destination_name")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  adults          Int      @default(2)
  children        Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile    Profile         @relation(fields: [userId], references: [userId])
  spots      TripSpot[]
  days       TripDay[]
  selections TripSelection[]

  @@index([userId])
  @@map("trip")
  @@schema("trips")
}

// No own id: a trip's spot picks are a value, not an independently addressable
// row, and are always replaced as a whole set by the trips route that owns them.
model TripSpot {
  tripId String @map("trip_id")
  spotId String @map("spot_id")
  name   String

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, spotId])
  @@map("trip_spot")
  @@schema("trips")
}

model TripDay {
  id       String   @id @default(uuid())
  tripId   String   @map("trip_id")
  dayIndex Int      @map("day_index")
  date     DateTime @db.Date

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stops TripStop[]

  @@unique([tripId, dayIndex])
  @@map("trip_day")
  @@schema("trips")
}

model TripStop {
  id                        String   @id @default(uuid())
  dayId                     String   @map("day_id")
  position                  Int
  spotId                    String   @map("spot_id")
  name                      String
  lat                       Float
  lng                       Float
  startsAt                  String   @map("starts_at") // "HH:MM", matches isoTimeSchema
  minutes                   Int
  travelMinutesFromPrevious Int?     @map("travel_minutes_from_previous")
  isFixed                   Boolean  @default(false) @map("is_fixed")

  day TripDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, position])
  @@map("trip_stop")
  @@schema("trips")
}

// No own id: one row per (trip, kind), replaced whole by PUT .../selections/:kind.
model TripSelection {
  tripId        String    @map("trip_id")
  kind          String
  offerSnapshot Json      @map("offer_snapshot")
  provider      String
  deepLink      String    @map("deep_link")
  priceMinor    Int       @map("price_minor")
  currency      String
  checkedAt     DateTime  @map("checked_at")
  bookedAt      DateTime? @map("booked_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, kind])
  @@map("trip_selection")
  @@schema("trips")
}
