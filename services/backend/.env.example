# Local defaults. Copy to .env and fill in LITEAPI_KEY (sandbox key from the
# liteAPI dashboard).
PORT=4002
NODE_ENV=development
LOG_LEVEL=info
# pretty (local) | json (deployed; one JSON object per line)
LOG_FORMAT=pretty

# Local Supabase (npx supabase start). Take values from `npx supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SCHEMA=backend
SUPABASE_URL=http://127.0.0.1:54321

LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_TIMEOUT_MS=8000
# Your liteAPI white-label booking site, which "book on …" links open.
# Optional outside production (links then use a placeholder); required in production.
LITEAPI_WHITELABEL_URL=
