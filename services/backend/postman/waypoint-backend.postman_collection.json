{
  "info": {
    "name": "Waypoint backend",
    "description": "Every route of `services/backend`. Sample trip: Tel Aviv → Lisbon, 12–16 May, 2 adults.\n\n**Setup (local):**\n1. `npx supabase start`, then `npm run dev` (backend on :4002).\n2. Set the collection variable `supabasePublishableKey` from `npx supabase status` (PUBLISHABLE_KEY). Change `email` if you like.\n3. Run **Auth → Send sign-in code**, open the local inbox at http://127.0.0.1:54324, copy the 6-digit code into the `otpCode` variable, then run **Auth → Verify code**. It saves `accessToken`; every other request sends it as a Bearer token.\n4. Tokens last ~1h: run **Auth → Refresh token** (or sign in again).\n\nRequests that create or find something save its id into a variable (`tripId`, `placeId`, `hotelId`, …) for the next ones. Every request gets a fresh `x-request-id`, so you can find it in the server log.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh request id per call, echoed back by the backend and stamped on its log lines.",
          "pm.request.headers.upsert({ key: 'x-request-id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4002"
    },
    {
      "key": "supabaseUrl",
      "value": "http://127.0.0.1:54321"
    },
    {
      "key": "supabasePublishableKey",
      "value": ""
    },
    {
      "key": "email",
      "value": "traveler@waypoint.local"
    },
    {
      "key": "otpCode",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "countryCode",
      "value": "PT"
    },
    {
      "key": "cityName",
      "value": "Lisbon"
    },
    {
      "key": "placeId",
      "value": ""
    },
    {
      "key": "hotelId",
      "value": ""
    },
    {
      "key": "tripId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth (Supabase)",
      "description": "Sign-in goes to Supabase Auth directly (as the app does), not to the backend.",
      "item": [
        {
          "name": "Send sign-in code",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"create_user\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/otp",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "otp"]
            },
            "description": "Emails a 6-digit code. Locally it lands in the inbox at http://127.0.0.1:54324. Put it in the `otpCode` variable."
          }
        },
        {
          "name": "Verify code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const value = pm.response.json().access_token;",
                  "  if (value) { pm.collectionVariables.set('accessToken', value); console.log('accessToken =', value); }",
                  "}",
                  "if (pm.response.code < 300) {",
                  "  const value = pm.response.json().refresh_token;",
                  "  if (value) { pm.collectionVariables.set('refreshToken', value); console.log('refreshToken =', value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"email\": \"{{email}}\",\n  \"token\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/verify",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "verify"]
            },
            "description": "Exchanges the code for a session and saves `accessToken` + `refreshToken`."
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const value = pm.response.json().access_token;",
                  "  if (value) { pm.collectionVariables.set('accessToken', value); console.log('accessToken =', value); }",
                  "}",
                  "if (pm.response.code < 300) {",
                  "  const value = pm.response.json().refresh_token;",
                  "  if (value) { pm.collectionVariables.set('refreshToken', value); console.log('refreshToken =', value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=refresh_token",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                }
              ]
            },
            "description": "New access token from the refresh token (each refresh token works once)."
          }
        }
      ]
    },
