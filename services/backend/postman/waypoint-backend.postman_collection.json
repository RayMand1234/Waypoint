          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": [\n    {\n      \"dayIndex\": 0,\n      \"date\": \"2027-05-12\",\n      \"stops\": [\n        {\n          \"position\": 0,\n          \"spotId\": \"belem-tower\",\n          \"name\": \"Belém Tower\",\n          \"lat\": 38.6916,\n          \"lng\": -9.216,\n          \"startsAt\": \"09:30\",\n          \"minutes\": 90,\n          \"travelMinutesFromPrevious\": null,\n          \"isFixed\": false\n        },\n        {\n          \"position\": 1,\n          \"spotId\": \"alfama\",\n          \"name\": \"Alfama\",\n          \"lat\": 38.7115,\n          \"lng\": -9.1301,\n          \"startsAt\": \"12:00\",\n          \"minutes\": 120,\n          \"travelMinutesFromPrevious\": 25,\n          \"isFixed\": true\n        }\n      ]\n    },\n    {\n      \"dayIndex\": 1,\n      \"date\": \"2027-05-13\",\n      \"stops\": [\n        {\n          \"position\": 0,\n          \"spotId\": \"lx-factory\",\n          \"name\": \"LX Factory\",\n          \"lat\": 38.7036,\n          \"lng\": -9.1786,\n          \"startsAt\": \"10:00\",\n          \"minutes\": 120,\n          \"travelMinutesFromPrevious\": null,\n          \"isFixed\": false\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/plan",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "plan"]
            },
            "description": "Replaces the whole plan. Days must fall inside the trip dates."
          }
        },
        {
          "name": "Select flight",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerSnapshot\": {\n    \"id\": \"tlv-lis-direct\",\n    \"note\": \"paste a FlightOffer from Search flights here\"\n  },\n  \"provider\": \"liteapi\",\n  \"deepLink\": \"https://whitelabel.invalid/booking?offerId=sample\",\n  \"price\": {\n    \"amountMinor\": 64020,\n    \"currency\": \"EUR\"\n  },\n  \"checkedAt\": \"2027-04-01T10:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/selections/flight",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "selections", "flight"]
            },
            "description": "`kind` is flight | stay | ticket. Store the offer exactly as shown."
          }
        },
        {
          "name": "Select stay",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerSnapshot\": {\n    \"hotel\": \"Casa Alfama (sample)\"\n  },\n  \"provider\": \"liteapi\",\n  \"deepLink\": \"https://whitelabel.invalid/hotels/lp-alfama\",\n  \"price\": {\n    \"amountMinor\": 52050,\n    \"currency\": \"EUR\"\n  },\n  \"checkedAt\": \"2027-04-01T10:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/selections/stay",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "selections", "stay"]
            }
          }
        },
        {
          "name": "Mark stay booked",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booked\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/selections/stay/booked",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "selections", "stay", "booked"]
            },
            "description": "A planned trip becomes `booked`; unticking everything takes it back to `planned`."
          }
        },
        {
          "name": "Unmark stay booked",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booked\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/selections/stay/booked",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "selections", "stay", "booked"]
            }
          }
        },
        {
          "name": "Delete trip",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}"]
            },
            "description": "204 on success."
          }
        }
      ]
    }
  ]
}
