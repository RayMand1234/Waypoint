{
  "name": "@waypoint/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "research": "tsx --env-file-if-exists=.env src/research/cli.ts"
  },
  "dependencies": {
    "@waypoint/contracts": "0.0.0",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2",
    "winston": "3.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/migrate.ts"
    ],
    "format": [
      "esm"
    ],
    "outDir": "dist",
    "clean": true,
    "noExternal": [
      "@waypoint/contracts"
    ]
  }
}
