# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app — never put
# a secret here (no service_role / secret key).

# Local Supabase (npx supabase status → API URL, Publishable key).
# On a real phone, use your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# services/backend
EXPO_PUBLIC_API_URL=http://127.0.0.1:4002

# Optional: Google sign-in (Google Cloud OAuth client ids). The button only
# shows when the web client id is set. The iOS URL scheme is the reversed iOS
# client id and needs a new dev build after changing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: Sign in with Apple (iOS only; needs the capability on your Apple
# developer account and a new dev build). Set to "enabled" to turn it on.
EXPO_PUBLIC_APPLE_SIGN_IN=
